<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device transfer on Android 12+ (API 31+). Only the app database is included: step
   history and user settings. WorkManager keeps its own database in no_backup storage, and
   scheduled alarms and work are recreated at app start, so nothing else needs restoring.
   The step sensor bookkeeping in the database detects a restore onto another device and resets.
   See https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
